{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/frat/", "destination": "/", "permanent": true },
    { "source": "/frat-blue/", "destination": "/", "permanent": true },
    { "source": "/frat/:path*", "destination": "/", "permanent": true },
    { "source": "/frat-blue/:path*", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/products/puraclear-acne-moisturizer", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] },
    { "source": "/(.*)", "missing": [{ "type": "host", "value": "(www\\.)?shoppuraclear\\.com" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/api/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
